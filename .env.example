# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_vote?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_vote

# JWT Authentication
JWT_SECRET="campus_chain_vote_jwt_super_secret_key_2026_secure"

# Nullifier Secret (Used to generate deterministic, anonymous nullifiers)
NULLIFIER_SECRET="campus_voting_secret_salt_for_deterministic_nullifiers_2026"

# Blockchain & Relayer Configuration
# Local Hardhat Node default account #0 private key
RELAYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
RELAYER_ADDRESS="0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266"
RPC_URL="http://127.0.0.1:8545"
CONTRACT_ADDRESS=""

# Optional Sepolia Configuration
SEPOLIA_RPC_URL="https://rpc.sepolia.org"
SEPOLIA_PRIVATE_KEY=""

# SMTP / Email Configuration for OTPs
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@campus.edu"

# Twilio SMS Configuration (for sending OTP via SMS to student phone numbers)
# Get these from https://console.twilio.com
# If not set, OTP falls back to email/console log in DEV_MODE
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Development & Testing Modes
DEV_MODE=true
DEV_SHOW_OTP=true

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"
PORT=5000
